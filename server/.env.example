# Backend (Node/Express) — SEGRETI. Mai committare .env vero, mai nel browser.
# In locale: copia in server/.env. In produzione: impostale su Railway.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # service_role key — bypassa RLS, TIENILA SEGRETA
SUPABASE_JWT_SECRET=super-secret-jwt...    # non letto da nessun codice: l'auth usa supabase.auth.getUser()
PORT=10000

# Origini ammesse per CORS, separate da virgola. Se vuota il server risponde a
# qualunque origine (comportamento storico), quindi in produzione impostala.
CORS_ORIGIN=https://tuo-dominio.vercel.app

# 1 quando il server sta dietro un proxy (Railway, Vercel): serve a leggere l'IP
# reale del client per il rate limit. Lascia 0 in locale, altrimenti
# X-Forwarded-For è falsificabile da chi chiama.
TRUST_PROXY=0
